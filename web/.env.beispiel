# Überzeit -- Einstellungen. Kopieren nach web/.env und anpassen (web/.env nie einchecken).
# Zufälligen Schlüssel erzeugen:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Öffentliche Adresse (für die Rückkehr von Authentik)
APP_URL=https://ueberzeit.example.de
HINTER_PROXY=1
# Adresse(n) des Reverse Proxys: über ihn gibt es kein Passwortformular (LOKALE_ANMELDUNG=intern)
PROXY_ADRESSEN=
COOKIE_NUR_HTTPS=auto

# Anmeldung über Authentik (OpenID Connect). Nur Mitglieder von OIDC_GRUPPE kommen hinein, jede Person mit eigenen Daten.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GRUPPE=Überzeit
OIDC_NAME=Authentik

# Passwortformular: intern (nur direkt im LAN), immer, nie
LOKALE_ANMELDUNG=intern
# Notzugang beim allerersten Start (ohne ERSTES_PASSWORT steht ein Zufallspasswort einmal im Protokoll)
ERSTER_BENUTZER=admin
